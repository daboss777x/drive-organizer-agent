{
  "permissions": {
    "deny": [
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash_gate.py\""}]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/edit_gate.py\""}]
      }
    ]
  }
}
